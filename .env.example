# Copy to .env and fill in.
#
# manage.py uses config.settings.dev (SQLite at db.sqlite3; nothing below is required).
# wsgi.py/asgi.py use config.settings.prod, which requires SECRET_KEY,
# ALLOWED_HOSTS and DATABASE_URL. To run manage.py against production settings:
#   DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=phogbs.example.com
CSRF_TRUSTED_ORIGINS=https://phogbs.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/phogbs

# Email (production uses SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PHOGBS <no-reply@phogbs.com>
SUPPORT_EMAIL=support@phogbs.com

# Optional
# MEDIA_ROOT=/var/lib/phogbs/media
# DB_CONN_MAX_AGE=60
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# INVITATION_VALID_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_THROTTLE_WINDOW_SECONDS=900
# IDENTITY_VERIFIER=apps.accounts.identity.NullIdentityVerifier
