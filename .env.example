# Copy to .env and fill in.
#
# manage.py uses config.settings.dev (SQLite at db.sqlite3; nothing below is required).
# wsgi.py/asgi.py use config.settings.prod, which requires SECRET_KEY,
# ALLOWED_HOSTS and DATABASE_URL. To run manage.py against production settings:
#   DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=phogbs.example.com
CSRF_TRUSTED_ORIGINS=https://phogbs.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/phogbs

# Email via Resend (production default). Create a key at resend.com/api-keys;
# the From address must be on a domain verified at resend.com/domains.
# Dev prints emails to the console unless EMAIL_BACKEND is set to:
#   apps.accounts.email_backends.ResendEmailBackend
RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=PHOGBS <no-reply@phogbs.com>
SUPPORT_EMAIL=support@phogbs.com

# File storage (production only): Supabase Storage via its S3-compatible
# API. Create both buckets in the Supabase dashboard first (Storage > New
# bucket); SUPABASE_S3_PRIVATE_BUCKET must be set to private there. Get the
# endpoint/region from Project Settings > Data API, and the key pair from
# Project Settings > Storage > S3 Access Keys (not the anon/service_role keys).
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION_NAME=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=...
SUPABASE_S3_SECRET_ACCESS_KEY=...
SUPABASE_S3_MEDIA_BUCKET=media
SUPABASE_S3_PRIVATE_BUCKET=private

# Optional
# MEDIA_ROOT=/var/lib/phogbs/media
# DB_CONN_MAX_AGE=60
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# INVITATION_VALID_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_THROTTLE_WINDOW_SECONDS=900
# IDENTITY_VERIFIER=apps.accounts.identity.NullIdentityVerifier
